---
import { SITE } from '../lib/site';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Writing' },
  { href: '/about', label: 'About' },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/85 backdrop-blur">
  <nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
    <a href="/" class="font-sans text-lg font-normal tracking-tight text-fg">
      {SITE.name}
    </a>
    <div class="flex items-center gap-2">
      <ul class="flex items-center gap-2">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="font-mono rounded px-3 py-1.5 text-[13px] tracking-[0.4px] text-fg-soft transition hover:text-fg"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </nav>
</header>
