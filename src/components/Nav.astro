---
import { SITE } from '../lib/site';
import ThemeToggle from './ThemeToggle.astro';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Writing' },
  { href: '/about', label: 'About' },
];
---

<header class="sticky top-0 z-50 border-b border-line bg-bg/85 backdrop-blur">
  <nav class="mx-auto flex max-w-3xl items-center justify-between px-6 py-4">
    <a href="/" class="font-serif text-xl font-semibold tracking-tight text-fg">
      {SITE.name}
    </a>
    <div class="flex items-center gap-1">
      <ul class="flex items-center gap-1">
        {
          nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="rounded-md px-3 py-1.5 text-[0.9375rem] font-medium text-fg-soft transition hover:text-fg"
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ThemeToggle />
    </div>
  </nav>
</header>
