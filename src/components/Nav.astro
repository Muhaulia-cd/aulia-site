---
import { SITE } from '../lib/site';

const nav = [
  { href: '/', label: 'Home' },
  { href: '/blog', label: 'Blog' },
  { href: '/about', label: 'About' },
];
---

<header class="sticky top-0 z-50 border-b border-zinc-200/70 bg-zinc-50/80 backdrop-blur dark:border-zinc-800 dark:bg-zinc-950/80">
  <nav class="mx-auto flex max-w-4xl items-center justify-between px-6 py-4">
    <a href="/" class="text-lg font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
      {SITE.name}<span class="text-accent">.</span>
    </a>
    <ul class="flex items-center gap-1">
      {
        nav.map((item) => (
          <li>
            <a
              href={item.href}
              class="rounded-lg px-3 py-1.5 text-sm font-medium text-zinc-600 transition hover:bg-accent-soft hover:text-accent dark:text-zinc-300 dark:hover:bg-zinc-800"
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
