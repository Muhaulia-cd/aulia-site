---
import { SITE } from '../lib/site';
---

<footer class="mt-auto border-t border-line">
  <div class="mx-auto flex max-w-3xl flex-col items-start justify-between gap-6 px-6 py-10 text-sm text-fg-faint sm:flex-row sm:items-center">
    <p class="font-mono text-[13px] tracking-[0.4px]">© {new Date().getFullYear()} {SITE.name}</p>
    <div class="flex flex-wrap gap-5">
      <a href={SITE.github} class="font-mono text-[13px] tracking-[0.4px] transition hover:text-fg">GitHub</a>
      <a href={SITE.linkedin} class="font-mono text-[13px] tracking-[0.4px] transition hover:text-fg">LinkedIn</a>
      <a href={`mailto:${SITE.email}`} class="font-mono text-[13px] tracking-[0.4px] transition hover:text-fg">Email</a>
    </div>
  </div>
</footer>
